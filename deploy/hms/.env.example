PUSHGO_IMAGE=ghcr.io/self-command/pushgo-gateway-hms:latest
PUSHGO_BIND_ADDRESS=127.0.0.1
PUSHGO_PORT=6666
PUSHGO_PUBLIC_BASE_URL=https://push.example.com
PUSHGO_TOKEN=
PUSHGO_HUAWEI_APP_ID=

# Optional metadata scalar limit, in UTF-8 bytes (1..16384). Default preserves upstream behavior.
PUSHGO_METADATA_MAX_VALUE_BYTES=512
